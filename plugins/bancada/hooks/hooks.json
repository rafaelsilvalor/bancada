{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/commit-guard.mjs"],
            "statusMessage": "bancada: commit gate",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
